#!/bin/sh
# Bloqueia dados brutos, CSVs e segredos; exige o gate P1–P6 verde para commits que tocam data/processed.
# Instalar: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
staged=$(git diff --cached --name-only --diff-filter=ACMR)
blocked=$(printf '%s\n' "$staged" | grep -E '^(data/geo/raw/|data/raw|data/interim)|\.(csv|CSV|sav|SAV)$|(^|/)\.env(\.|$)|\.(pem|key|p12|pfx)$|credentials.*\.json$' || true)
if [ -n "$blocked" ]; then
  echo "ERRO: arquivos bloqueados para commit:" >&2
  printf '%s\n' "$blocked" | sed 's/^/  - /' >&2
  exit 1
fi
if printf '%s\n' "$staged" | grep -q '^data/processed/'; then
  PY="${PYTHON:-python3}"
  $PY -m pipeline.verify_gate || { echo "ERRO: gate P1–P6 não verificado (rode pipeline/gate_check.py)." >&2; exit 1; }
fi
